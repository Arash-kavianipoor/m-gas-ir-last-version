# Auto detect text files and perform LF normalization
* text=auto

# Windows scripts use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Source code and config use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Explicit binaries
*.exe binary
*.db binary
*.ico binary
*.xlsx binary
*.ttf binary
*.svg text
