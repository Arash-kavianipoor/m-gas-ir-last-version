{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ir.mgas.warehouse.win7",
  "productName": "Warehouse Management - Windows 7",
  "copyright": "Copyright © 2026 M-Gas",
  "electronVersion": "22.3.27",
  "directories": {
    "output": "release-dist"
  },
  "files": [
    "dist/**/*",
    "apps/desktop/**/*",
    "package.json",
    "node_modules/sql.js/**/*"
  ],
  "extraResources": [
    {
      "from": "src/database/canonical-schema.sql",
      "to": "canonical-schema.sql"
    },
    {
      "from": "public/troubleshooting_win7.txt",
      "to": "راهنمای_عیب‌یابی_ویندوز_۷.txt"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "signAndEditExecutable": false,
    "signExecutable": false,
    "artifactName": "Warehouse-Windows7-Setup.${ext}",
    "executableName": "Warehouse"
  },
  "nsis": {
    "warningsAsErrors": false,
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "include": "installer-warehouse.nsh",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "سیستم انبارداری ام گاز (انبار مرکزی)",
    "runAfterFinish": true
  }
}
